# Copy this file to .env for local development and add your own Gemini API key.
# Never commit or submit the real .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH_SIZE=25
RETRIEVAL_CONFIDENCE_THRESHOLD=0.08
